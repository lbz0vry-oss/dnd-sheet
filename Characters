/* =========================================================
   LEVEL UP
========================================================= */

const STAT_POINT_LEVELS=[2,4,6,8,10];

const STAT_POINTS_PER_MILESTONE=2;

const STAT_MAX=20;

function levelUp(){

    if(charState.level>=10){

        alert("ถึง Level สูงสุดแล้ว");

        return;
    }

    charState.level++;

    /*
       ได้ Stat Point เฉพาะ Lv.2,4,6,8,10
       ครั้งละ 2 แต้ม
    */

    if(STAT_POINT_LEVELS.includes(charState.level)){

        charState.points+=pointsPerMilestone();

    }

    /*
       SP กลับเต็มเมื่อ Level Up
    */

    charState.sp=charState.maxSP;

    renderAll();

}


/* =========================================================
   LEVEL DOWN
========================================================= */

function levelDown(){

    if(charState.level<=1)
        return;

    /*
       ถ้าลดต่ำกว่า Level 5
       จะยกเลิก Subclass
    */

    const leavingLevel=charState.level;

    charState.level--;

    if(STAT_POINT_LEVELS.includes(leavingLevel)){

        charState.points=
            Math.max(
                0,
                charState.points-pointsPerMilestone()
            );

    }

    if(charState.level<5){

        selectedSubclass=null;

    }

    renderAll();

}


