/* =========================================================
   CHANGE STAT
========================================================= */

function addStat(stat){

    if(charState.points<=0)
        return;

    if(charState.stats[stat]>=STAT_MAX){

        alert("ค่าสเตตัสสูงสุดคือ 20");

        return;
    }

    charState.stats[stat]++;

    charState.points--;

    renderAll();

}


function subStat(stat){

    const base=
        baseStatsFor(getClass())[stat];

    if(
        charState.stats[stat]
        <=base
    ){

        return;
    }

    charState.stats[stat]--;

    charState.points++;

    renderAll();

}


