        "Level "+skill.reqLv;

    document
        .getElementById("detailSP")
        .textContent=
        effectiveCost(skill)!==skill.cost
        ?skill.cost+" → "+effectiveCost(skill)+" SP (Arcane Economy)"
        :skill.cost+" SP";

    document
        .getElementById("detailRange")
        .textContent=
        skill.range;

    document
        .getElementById("detailMod")
        .textContent=
        skill.modifier;

    document
        .getElementById("detailDamage")
        .textContent=
        skill.damage;

    document
        .getElementById("detailEffect")
        .textContent=
        skill.effect;

    document
        .getElementById("detailDesc")
        .textContent=
        skill.desc;

    document
        .getElementById("modal")
        .classList.add("show");

}


function closeModal(event){

    if(
        event &&
        event.target.id!=="modal"
    ){

        return;

    }

    document
        .getElementById("modal")
        .classList.remove("show");

}


/* =========================================================
   RENDER ALL
========================================================= */

function renderAll(){

    renderClassSelector();

    renderRace();

    charState.armorTier=Math.min(charState.armorTier||0,maxUnlockedTier());

    charState.weaponTier=Math.min(charState.weaponTier||0,maxUnlockedTier());

    renderCharacter();

    renderEquipment();

    renderStats();

    renderSavingThrows();

    renderSkillFilter();

    renderDndSkills();

    renderSubclasses();

    renderPassive();

    renderBaseSkills();

    renderSubclassSkills();

}


/* =========================================================
   INITIALIZE
========================================================= */

charState.stats=baseStatsFor(CLASSES_DATA[0]);

renderAll();

</script>


<script>
/* collapsible panels + ESC to close modal */
document.querySelectorAll(".panel[data-fold]").forEach(p=>{
    const t=p.querySelector(".panel-title");
    const sync=()=>t.setAttribute("aria-expanded",!p.classList.contains("folded"));
    const toggle=()=>{p.classList.toggle("folded");sync();};
    t.tabIndex=0;t.setAttribute("role","button");
    t.onclick=toggle;
    t.onkeydown=e=>{if(e.key==="Enter"||e.key===" "){e.preventDefault();toggle();}};
    if(p.dataset.fold==="closed"&&innerWidth<=1100)p.classList.add("folded");
    sync();
});
document.addEventListener("keydown",e=>{if(e.key==="Escape")closeModal();});
</script>

</body>
