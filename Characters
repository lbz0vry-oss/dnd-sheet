<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="theme-color" content="#0b0d17">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">

<title>Fantasy Pixel RPG Character Sheet</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&family=Press+Start+2P&display=swap" rel="stylesheet">

<style>
:root{
--bg:#0b0d17;--panel:#151a2b;--panel2:#10142200;--panel3:#1f2640;--inset:#0d1020;
--line:#3a4466;--line2:#5b6a96;--ink:#04050a;
--text:#eef1fb;--muted:#98a2c0;
--gold:#ffcf5a;--gold2:#ffe5a0;--accent-gold:#ffcf5a;
--red:#ff6464;--green:#6bdc9a;--blue:#6cb0ff;--purple:#c58aff;--orange:#ff9b58;--cyan:#5fdcec;
--hh:64px;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
}
*{box-sizing:border-box;--pxb:0 -2px 0 0 var(--c,#3a4466),0 2px 0 0 var(--c,#3a4466),-2px 0 0 0 var(--c,#3a4466),2px 0 0 0 var(--c,#3a4466)}
html{scroll-behavior:smooth;scroll-padding-top:calc(var(--hh) + env(safe-area-inset-top,0px))}
body{margin:0;min-height:100%;color:var(--text);font-family:"Kanit",sans-serif;line-height:1.4;
background:var(--bg)}
button{font-family:inherit;color:inherit}
button:disabled{cursor:not-allowed}
.pixel{font-family:"Press Start 2P",monospace}
:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
::-webkit-scrollbar{width:10px;height:10px}
::-webkit-scrollbar-track{background:var(--inset)}
::-webkit-scrollbar-thumb{background:var(--line2);border:2px solid var(--inset)}
*{scrollbar-color:var(--line2) var(--inset);scrollbar-width:thin}

/* HEADER */
header{position:sticky;top:0;z-index:100;background:rgba(7,9,16,.97);border-bottom:2px solid var(--line);padding-top:env(safe-area-inset-top,0px)}
.header-inner{max-width:1550px;margin:auto;padding:10px 20px;min-height:var(--hh);display:flex;align-items:center;justify-content:space-between;gap:16px}
.logo{font-family:"Press Start 2P",monospace;color:var(--gold);font-size:12px;line-height:1.6}
.logo span{display:block;margin-top:4px;color:var(--muted);font-family:"Kanit",sans-serif;font-size:12px;text-shadow:none}
.tabs{display:flex;gap:10px}
.tab{--c:var(--line);padding:10px 16px;border:none;background:var(--inset);cursor:pointer;font-family:"Press Start 2P",monospace;font-size:10px;color:var(--muted);box-shadow:var(--pxb);transition:transform .08s}
.tab:hover{color:#fff;--c:var(--line2)}
.tab.active{--c:var(--gold2);background:var(--gold);color:#1a1200}

/* MAIN */
.container{width:min(1550px,100%);margin:auto;padding:22px 20px 40px}
.page{display:none}
.page.active{display:block}

/* CLASS SELECTOR */
.class-selector{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:22px}
.class-btn{--c:var(--line);position:relative;display:grid;grid-template-columns:56px 1fr;column-gap:14px;align-items:center;min-height:84px;padding:13px 14px;background:var(--panel);border:none;text-align:left;cursor:pointer;box-shadow:var(--pxb);transition:transform .1s}
.class-btn:hover{--c:var(--line2)}
.class-btn.active{--c:var(--gold);background:rgba(255,207,90,.08)}
.class-icon{float:none;grid-row:span 2;width:56px;height:56px;display:grid;place-items:center;font-size:30px;background:var(--inset);box-shadow:inset 0 0 0 2px var(--line)}
.class-btn.active .class-icon{box-shadow:inset 0 0 0 2px var(--gold)}
.class-name{font-size:18px;font-weight:600;align-self:end}
.class-role{color:var(--muted);font-size:13px;align-self:start}

/* LAYOUT */
.rpg-layout{display:grid;grid-template-columns:380px minmax(0,1fr);gap:22px;align-items:start}
aside{position:sticky;top:calc(var(--hh) + 14px);max-height:calc(100vh - var(--hh) - 28px);overflow-y:auto;padding:5px 12px 12px 5px;margin:-5px -12px -12px -5px}
.panel{--c:var(--line);background:var(--panel);box-shadow:var(--pxb);overflow:hidden}
.panel + .panel{margin-top:18px}
.panel-title{padding:12px 14px;background:transparent;border-bottom:2px solid var(--line);color:#c9d0e4;font-family:"Press Start 2P",monospace;font-size:9px;line-height:1.5;display:flex;justify-content:space-between;align-items:center;gap:10px}
.panel-title > span:not(:first-child){font-family:"Kanit",sans-serif;font-weight:400;font-size:12px;color:var(--muted)}
.panel-body{padding:14px}
.panel[data-fold] > .panel-title{cursor:pointer;user-select:none}
.panel[data-fold] > .panel-title::after{content:"▼";color:var(--muted);font-size:9px;margin-left:auto;padding-left:10px}
.panel[data-fold].folded > .panel-title::after{content:"▶"}
.panel[data-fold].folded > .panel-body{display:none}
.panel[data-fold].folded > .panel-title{border-bottom:none}
.panel[data-fold] > .panel-title:hover{color:#fff}

/* CHARACTER */
.character-header{text-align:center;padding:20px 14px 16px;border-bottom:2px solid var(--line)}
.character-avatar{--c:var(--gold);width:88px;height:88px;margin:4px auto 0;display:grid;place-items:center;background:var(--inset);font-size:46px;box-shadow:var(--pxb)}
.character-name{margin-top:14px;font-size:22px;font-weight:600}
.character-name-input{width:100%;background:transparent;border:none;border-bottom:2px solid var(--line2);color:var(--text);text-align:center;font-family:"Kanit",sans-serif;outline:none;padding:2px 0 4px;transition:border-color .15s}
.character-name-input:focus{border-bottom-color:var(--gold)}
.character-name-input::placeholder{color:var(--muted)}
.race-row{margin-top:12px;display:flex;justify-content:center}
.race-select{--c:var(--line2);background:var(--inset);color:var(--text);border:none;box-shadow:var(--pxb);padding:7px 12px;min-width:170px;font-family:"Kanit",sans-serif;font-size:14px;cursor:pointer;outline:none}
.race-select:focus{--c:var(--gold)}
.race-bonus{margin-top:8px;min-height:16px;color:var(--cyan);font-size:12px}
.level-text{margin-top:6px;color:var(--gold);font-family:"Press Start 2P",monospace;font-size:12px}
.level-controls{display:flex;justify-content:center;gap:10px;margin-top:12px}
.level-btn{--c:var(--line2);min-width:70px;min-height:38px;padding:6px 12px;border:none;background:var(--inset);cursor:pointer;font-size:13px;font-weight:600;box-shadow:var(--pxb);transition:transform .08s}
.level-btn:hover{--c:var(--gold);background:var(--gold);color:#1a1200}
.level-btn:last-child:hover{--c:var(--red);background:var(--red);color:#1a0000}

/* HP + COMBAT */
.hp-box{margin-top:16px}
.hp-label{display:flex;justify-content:space-between;align-items:baseline;font-size:13px;color:var(--muted)}
.hp-label span:last-child{color:var(--text);font-family:"Press Start 2P",monospace;font-size:11px}
.hp-bar{--c:var(--ink);position:relative;height:12px;margin-top:6px;background:var(--inset);box-shadow:var(--pxb),inset 0 0 0 2px var(--line)}
.hp-fill{height:100%;width:100%;background:var(--red);transition:width .25s steps(8)}
.combat-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:16px}
.combat-stat{--c:var(--line);padding:10px 2px 8px;background:var(--inset);text-align:center;box-shadow:var(--pxb)}
.combat-stat b{display:block;color:var(--gold);font-family:"Press Start 2P",monospace;font-size:13px;white-space:nowrap;line-height:1.4}
.combat-stat small{display:block;margin-top:5px;color:var(--muted);font-size:11px;letter-spacing:.5px}
.ac-detail{margin-top:10px;padding:8px 10px;background:var(--inset);box-shadow:inset 3px 0 0 var(--line2);color:#c9d0e4;font-size:12px;line-height:1.55;text-align:left}
.ac-detail span{color:var(--muted)}

/* ABILITY SCORES */
.section-title{margin:0 0 12px;color:#c9d0e4;font-family:"Press Start 2P",monospace;font-size:10px;font-weight:400}
.stat-points{--c:var(--line);margin-bottom:14px;padding:10px 12px;background:var(--inset);box-shadow:var(--pxb);display:flex;justify-content:space-between;align-items:center;font-size:13px}
.stat-points strong{color:var(--gold);font-family:"Press Start 2P",monospace;font-size:13px}
.stats-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.stat{--c:var(--line);display:grid;grid-template-columns:34px 1fr auto;align-items:center;gap:6px;padding:8px;background:var(--inset);box-shadow:var(--pxb)}
.stat-name{color:var(--muted);font-family:"Press Start 2P",monospace;font-size:9px}
.stat-value{font-family:"Press Start 2P",monospace;font-size:14px;line-height:1.3}
.mod{margin-top:2px;color:var(--green);font-size:12px}
.stat-race{margin-left:4px;color:var(--cyan);font-size:11px}
.stat-buttons{display:flex;flex-direction:row;gap:4px}
.stat-buttons button{width:28px;height:32px;padding:0;border:none;background:var(--inset);box-shadow:inset 0 0 0 2px var(--line2);cursor:pointer;font-size:16px;font-weight:700;line-height:1}
.stat-buttons button:hover{background:var(--gold);color:#1a1200}

/* SAVES + D&D SKILLS */
.save-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}
.save-row,.dnd-skill{--c:var(--line);background:var(--inset);box-shadow:var(--pxb)}
.save-row{display:flex;align-items:center;justify-content:space-between;padding:8px 10px}
.save-left{display:flex;align-items:center;gap:8px}
.save-proficient,.dnd-skill-dot{width:10px;height:10px;background:#3b4360;flex:none}
.save-row.proficient{--c:#7d6a30}
.save-row.proficient .save-proficient{background:var(--gold)}
.save-name{font-size:13px;color:#c1c9de}
.save-value{color:var(--green);font-family:"Press Start 2P",monospace;font-size:11px}
.skill-filter{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}
.filter-btn{--c:var(--line);padding:6px 10px;border:none;background:var(--inset);color:var(--muted);cursor:pointer;font-size:12px;box-shadow:var(--pxb)}
.filter-btn:hover{color:#fff}
.filter-btn.active{--c:var(--gold2);color:#1a1200;background:var(--gold)}
.dnd-skills{display:grid;grid-template-columns:1fr;gap:7px;max-height:440px;overflow-y:auto;padding:3px 8px 3px 3px}
.dnd-skill{display:grid;grid-template-columns:12px 1fr auto;gap:8px;align-items:center;padding:7px 10px}
.dnd-skill.proficient{--c:#2f6a4a}
.dnd-skill.proficient .dnd-skill-dot{background:var(--green)}
.dnd-skill-name{font-size:13px}
.dnd-skill-ability{color:var(--muted);font-size:11px}
.dnd-skill-value{color:var(--green);font-family:"Press Start 2P",monospace;font-size:11px}

/* EQUIPMENT */
.equip-slot + .equip-slot{margin-top:16px}
.equip-label{font-size:13px;font-weight:600;color:#cdd4e8}
.equip-current{margin:6px 0 10px;padding:8px 10px;background:var(--inset);box-shadow:inset 3px 0 0 var(--gold);color:var(--gold2);font-size:13px}
.tier-row{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.tier-btn{--c:var(--line);padding:8px 4px;text-align:center;background:var(--inset);border:none;box-shadow:var(--pxb);color:var(--muted);cursor:pointer;line-height:1.35}
.tier-btn b{display:block;font-size:13px;font-weight:600}
.tier-btn span{display:block;font-size:11px}
.tier-btn:hover:not(:disabled){--c:var(--line2);color:#fff}
.tier-btn.active{--c:var(--gold2);background:var(--gold);color:#1a1200}
.tier-btn.locked{opacity:.4}
.equip-hint{margin-top:14px;color:var(--muted);font-size:11px;text-align:center}

/* SUBCLASS */
.subclass-list{display:grid;gap:10px}
.subclass-btn{--c:var(--line);width:100%;padding:11px 12px;text-align:left;background:var(--inset);border:none;box-shadow:var(--pxb);cursor:pointer;transition:transform .1s}
.subclass-btn:hover:not(.locked){--c:var(--line2)}
.subclass-btn.selected{--c:var(--purple);background:rgba(197,138,255,.14)}
.subclass-btn.locked{opacity:.45;cursor:not-allowed}
.subclass-btn strong{display:block;font-size:14px}
.subclass-btn small{color:var(--muted);font-size:12px}

/* SKILL TREE */
.skill-header{flex-wrap:wrap}
.sp-display{--c:var(--blue);display:flex;align-items:center;gap:10px;padding:7px 12px;background:var(--inset);box-shadow:var(--pxb);font-family:"Kanit",sans-serif;font-size:13px;color:var(--blue)}
.sp-number{color:var(--text);font-family:"Press Start 2P",monospace!important;font-size:12px!important}
.passive-box{--c:#7d6a30;padding:14px 16px;margin-bottom:22px;background:rgba(255,207,90,.06);box-shadow:var(--pxb)}
.passive-title{color:var(--gold);font-family:"Press Start 2P",monospace;font-size:9px;margin-bottom:8px}
.passive-desc{color:#cfd5e6;line-height:1.6;font-size:14px}
.passive-race{margin-top:10px;padding-top:10px;border-top:2px solid #2f6b75;color:#8fe6f2}
.passive-race small{display:block;margin-top:4px;color:var(--muted)}
.passive-subclass{margin-top:10px;padding-top:10px;border-top:2px solid #6a4f8c;color:#dab4ff}
.skill-section{margin-top:22px}
.section-line-title{display:flex;align-items:center;gap:12px;margin-bottom:14px}
.section-line-title h3{margin:0;font-size:16px;font-weight:600;white-space:nowrap}
.section-line{flex:1;height:2px;background:var(--line)}
.skill-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.skill-slot{--c:var(--line);position:relative;overflow:hidden;background:var(--panel);box-shadow:var(--pxb);cursor:pointer;transition:transform .1s}
.skill-slot:hover{--c:var(--gold)}
.skill-slot.subclass-skill{--c:#7a5aa6}
.skill-slot.subclass-skill:hover{--c:var(--purple)}
.skill-slot.locked{opacity:.45}
.skill-top{display:flex;align-items:center;gap:12px;padding:12px 12px 8px}
.skill-icon{flex:0 0 48px;width:48px;height:48px;display:grid;place-items:center;font-size:26px;background:var(--inset);box-shadow:inset 0 0 0 2px var(--line2)}
.subclass-skill .skill-icon{box-shadow:inset 0 0 0 2px var(--purple)}
.skill-info{flex:1;min-width:0}
.skill-name{font-size:16px;font-weight:600;line-height:1.25}
.skill-type{margin-top:3px;color:var(--muted);font-size:12px}
.upgrade-badge{display:inline-block;margin-left:6px;padding:0 6px;background:rgba(197,138,255,.2);color:var(--purple);font-size:10px;font-weight:600;vertical-align:middle;box-shadow:inset 0 0 0 1px var(--purple)}
.skill-cost{align-self:flex-start;padding:4px 8px;background:var(--inset);box-shadow:inset 0 0 0 2px #2d5a96;color:var(--blue);font-size:12px;font-weight:600;white-space:nowrap}
.skill-body{padding:0 12px 12px}
.skill-effect{color:#d3d9ea;font-size:13px;line-height:1.5}
.skill-damage-line{margin-top:8px;display:flex;gap:8px;align-items:center;font-size:13px;color:var(--muted)}
.skill-damage-line .dmg-value{color:var(--red);font-weight:700}
.skill-desc-preview,.tag.damage{display:none}
.skill-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
.tag{padding:2px 7px;background:var(--inset);box-shadow:inset 0 0 0 1px var(--line);color:#d8dde7;font-size:11px}
.tag.level{color:var(--gold2);box-shadow:inset 0 0 0 1px #7d6a30}
.tag.modifier{color:var(--green);box-shadow:inset 0 0 0 1px #2f6a4a}
.tag.range{color:#bfe3ff;box-shadow:inset 0 0 0 1px #2d5a96}
.lock-overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(5,7,12,.5);font-size:13px;font-weight:600;gap:6px}
.empty-tree{grid-column:1/-1;padding:30px;text-align:center;border:3px dashed var(--line);color:var(--muted)}

/* DATABASE */
.database{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.db-card{--c:var(--line);padding:16px 18px;background:var(--inset);box-shadow:var(--pxb)}
.db-card h3{margin:0 0 10px;color:var(--gold);font-size:17px}
.db-card p{margin:0 0 8px;color:#b4bcd2;line-height:1.65;font-size:14px}

/* MODAL */
.modal{position:fixed;inset:0;z-index:500;display:none;align-items:center;justify-content:center;padding:20px;background:rgba(2,3,8,.82)}
.modal.show{display:flex}
.skill-detail{--c:var(--gold);width:min(640px,100%);max-height:calc(100vh - 40px);overflow-y:auto;background:var(--panel);box-shadow:var(--pxb)}
.detail-header{display:flex;align-items:center;gap:16px;padding:16px 18px;background:transparent;border-bottom:2px solid var(--line)}
.detail-icon{width:68px;height:68px;flex:0 0 68px;display:grid;place-items:center;background:var(--inset);box-shadow:inset 0 0 0 3px var(--gold);font-size:38px}
.detail-name{font-size:22px;font-weight:600;line-height:1.25}
.detail-sub{color:var(--muted);font-size:13px}
.detail-content{padding:8px 18px 18px}
.detail-row{display:grid;grid-template-columns:130px 1fr;gap:10px;padding:10px 0;border-bottom:2px solid #2c3452}
.detail-label{color:var(--muted);font-size:13px}
.detail-value{color:var(--text);line-height:1.55}
.close-btn{--c:var(--line2);width:100%;min-height:44px;margin-top:16px;border:none;background:var(--inset);cursor:pointer;font-family:"Press Start 2P",monospace;font-size:10px;box-shadow:var(--pxb)}
.close-btn:hover{--c:var(--gold);background:var(--gold);color:#1a1200}

/* RESPONSIVE */
@media(max-width:1100px){
.rpg-layout{grid-template-columns:1fr}
aside{position:static;max-height:none;overflow:visible;padding:0;margin:0}
}
@media(max-width:750px){
:root{--hh:54px}
.container{padding:14px 12px 30px}
.header-inner{padding:8px 12px;gap:10px}
.logo{font-size:10px}.logo span{display:none}
.tab{padding:9px 10px;font-size:9px}
.class-selector{grid-template-columns:1fr;gap:12px}
.skill-grid,.database{grid-template-columns:1fr}
.dnd-skills{max-height:360px}
.modal{align-items:flex-end;padding:0}
.skill-detail{max-height:88vh;width:100%}
.detail-row{grid-template-columns:100px 1fr}
}
@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}


.pxi{display:inline-block;width:24px;height:24px;vertical-align:middle}
.class-icon .pxi,.skill-icon .pxi{display:block;width:36px;height:36px}
.character-avatar .pxi{display:block;width:60px;height:60px}
.detail-icon .pxi{display:block;width:48px;height:48px}
.lock-overlay .pxi{display:none}
</style>
</head>

<body>

<!-- =========================================================
     HEADER
========================================================= -->

<header>

<div class="header-inner">

    <div class="logo">
        FANTASY RPG
        <span>CHARACTER SHEET & SKILL TREE</span>
    </div>

    <div class="tabs">

        <button
            class="tab active"
            onclick="switchPage('status',this)"
        >
            CHARACTER
        </button>

        <button
            class="tab"
            onclick="switchPage('database',this)"
        >
            DATABASE
        </button>

    </div>

</div>

</header>


<main class="container">

<!-- =========================================================
     CHARACTER PAGE
========================================================= -->

<section
    id="status"
    class="page active"
>

    <!-- CLASS SELECTOR -->
    <div
        id="classSelector"
        class="class-selector"
    ></div>


    <div class="rpg-layout">

        <!-- =================================================
             LEFT CHARACTER PANEL
        ================================================= -->

        <aside>

            <!-- CHARACTER -->
            <div class="panel">

                <div class="character-header">

                    <div
                        id="avatar"
                        class="character-avatar"
                    >
                        ⚔️
                    </div>

                    <input
                        id="characterName"
                        class="character-name character-name-input"
                        value="ผู้กล้าอาเรีย"
                        placeholder="ตั้งชื่อตัวละคร..."
                        oninput="charState.name=this.value"
                    >

                    <div class="race-row">
                        <select
                            id="raceSelect"
                            class="race-select"
                            onchange="selectRace(this.value)"
                        ></select>
                    </div>

                    <div id="raceBonus" class="race-bonus"></div>

                    <div
                        id="levelText"
                        class="level-text"
                    >
                        LEVEL 1
                    </div>

                    <div class="level-controls">

                        <button
                            class="level-btn"
                            onclick="levelDown()"
                        >
                            − LV
                        </button>

                        <button
                            class="level-btn"
                            onclick="levelUp()"
                        >
                            + LV
                        </button>

                        <button
                            class="level-btn"
