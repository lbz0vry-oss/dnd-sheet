  <path d="M14 45h36v7H14zM18 12h8v32h-8zM38 12h8v32h-8zM26 20h12v7H26zM26 33h12v7H26z" fill="#f3f6ff"/>
  <path d="M22 12h20v6H22zM27 27h10v6H27zM22 40h20v5H22z" fill="#ffb347"/>
