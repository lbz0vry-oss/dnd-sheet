    if(_pxCache[key])return _pxCache[key];
    const rows=PIX.shapes[m[0]],pal=m[1];
    const h=rows.length,w=Math.max(...rows.map(r=>r.length));
    const ox=Math.floor((12-w)/2),oy=Math.floor((12-h)/2);
    let r="";
    rows.forEach((row,y)=>{
        let x=0;
        while(x<row.length){
            const ch=row[x];
            if(ch==="."){x++;continue;}
            let x2=x;
            while(x2<row.length&&row[x2]===ch)x2++;
            r+=`<rect x="${x+ox}" y="${y+oy}" width="${x2-x}" height="1" fill="${pal[ch]}"/>`;
            x=x2;
        }
    });
    return _pxCache[key]=`<svg class="pxi" viewBox="0 0 12 12" shape-rendering="crispEdges" aria-hidden="true">${r}</svg>`;
