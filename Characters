/* =========================================================
   HELPERS
========================================================= */

function getClass(){

    return CLASSES_DATA.find(
        c=>c.id===currentClassId
    );

}


function effectiveCost(skill){

    if(typeof skill.cost!=="number") return skill.cost;

    if(currentClassId==="Mage") return Math.max(1, skill.cost-1);

    return skill.cost;

}


function calcModVal(score){

    return Math.floor(
        (score-10)/2
    );

}


function calcModStr(score){

    const mod=calcModVal(score);

    return mod>=0
        ? "+"+mod
        : String(mod);

}


function getProficiencyBonus(){

    return Math.floor(
        (charState.level-1)/4
    )+2;

}


function calcMaxHP(){

    const c=getClass();

    const conMod=
        calcModVal(
            charState.stats.CON
        );

    let subBonus=0;

    if(selectedSubclass){

        const sub=c.subclasses.find(
            x=>x.id===selectedSubclass
        );

        if(sub && sub.hpBonusPerLevel)
            subBonus=sub.hpBonusPerLevel*charState.level;

    }

    return Math.max(
        1,

        c.hpBase+

        conMod*c.hpConMult+

        (
            (charState.level-1)*
            (c.hpPerLevel+conMod)
        )+

        subBonus
    );

}


function getArmor(){

    const c=getClass();

    if(selectedSubclass){

        const sub=c.subclasses.find(
            x=>x.id===selectedSubclass
        );

        if(sub && sub.armor)
            return sub.armor;

    }

    return c.armor;

}


