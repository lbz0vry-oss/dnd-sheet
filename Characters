function equipKey(){

    return selectedSubclass || currentClassId;

}


function maxUnlockedTier(){

    let t=0;

    TIER_LEVELS.forEach((lv,i)=>{

        if(charState.level>=lv) t=i;

    });

    return t;

}


function getACBreakdown(tier){

    if(tier===undefined) tier=charState.armorTier||0;

    const a=getArmor();

    const row=(ARMOR_TIERS[equipKey()]||[])[tier];

    const name=row?row[0]:a.name;

    const base=row?row[1]:a.base;

    const dexMod=calcModVal(charState.stats.DEX);

    let dexPart=dexMod;

    if(a.dexCap===0) dexPart=0;
    else if(typeof a.dexCap==="number")
        dexPart=Math.min(dexMod,a.dexCap);

    const parts=[base+" ฐาน"];

    let total=base+dexPart;

    if(a.dexCap===0)
        parts.push("ไม่บวก DEX");
    else
        parts.push(
            (dexPart>=0?"+":"")+dexPart+" DEX"+
            (typeof a.dexCap==="number"?" (สูงสุด +"+a.dexCap+")":"")
        );

    if(a.extra){

        let m=calcModVal(charState.stats[a.extra]);

        if(typeof a.extraCap==="number")
            m=Math.min(m,a.extraCap);

        total+=m;

        parts.push(
            (m>=0?"+":"")+m+" "+a.extra+
            (typeof a.extraCap==="number"?" (สูงสุด +"+a.extraCap+")":"")
        );

    }

    if(a.shield){

        total+=a.shield;

        parts.push("+"+a.shield+" โล่");

    }

    if(a.bonus){

        total+=a.bonus;

        parts.push("+"+a.bonus+" โบนัส");

    }

    return {total,parts,name};

}


function calcAC(){

    return getACBreakdown().total;

}


function getATKBreakdown(tier){

    if(tier===undefined) tier=charState.weaponTier||0;

    const w=WEAPONS[equipKey()];

    let best=-99;

    let bestAb=w.ab[0];

    w.ab.forEach(ab=>{

        const m=calcModVal(charState.stats[ab]);

        if(m>best){

            best=m;

            bestAb=ab;

        }

    });

    const prof=getProficiencyBonus();

    const tb=WEAPON_TIER_BONUS[tier];

    let total=prof+best+tb+(w.acc||0);

    const parts=[

        "+"+prof+" PROF",

        (best>=0?"+":"")+best+" "+bestAb,

        "+"+tb+" อาวุธ"

    ];

    if(w.acc) parts.push("+"+w.acc+" แม่นยำ");

    return {total,parts,name:w.names[tier],abilities:w.ab,usedAbility:bestAb};

}


function calcATK(){

    return getATKBreakdown().total;

}


function fmtBonus(n){

    return (n>=0?"+":"")+n;

}


